[Unit]
Description=restic backup of %f from server
Documentation=https://tribe-framework.org/backup
After=network-online.target rest-server.service tailscaled.service
Requires=rest-server.service

[Service]
Type=oneshot
# %f is the instance name unescaped back into an absolute path, so
# restic-backup@-mnt-postcode.service passes /mnt/postcode to the script.
ExecStart=/usr/bin/ssh -o BatchMode=yes -o ServerAliveInterval=60 \
  root@server /usr/local/bin/restic-backup.sh %f
TimeoutStartSec=infinity
