#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const readline = require('readline');
const { spawnSync } = require('child_process');

const ENV_FILE = path.join(__dirname, '.env');
const NGINX_AVAILABLE = '/etc/nginx/sites-available';
const NGINX_ENABLED = '/etc/nginx/sites-enabled';
const PLACEHOLDER_HOSTS = ['localhost', 'domain.tld', 'alt.domain.tld', 'junction.domain.tld', 'analytics.domain.tld'];

const RED = '\x1b[0;31m', GREEN = '\x1b[0;32m', YELLOW = '\x1b[1;33m', CYAN = '\x1b[0;36m', BOLD = '\x1b[1m', NC = '\x1b[0m';
const log = (...a) => console.log(`${GREEN}✓${NC}  ${a.join(' ')}`);
const warn = (...a) => console.log(`${YELLOW}⚠${NC}  ${a.join(' ')}`);
const info = (...a) => console.log(`${CYAN}→${NC}  ${a.join(' ')}`);
const die = (...a) => { console.error(`${RED}✗${NC}  ${a.join(' ')}`); process.exit(1); };

function hostFromEnv(value) {
  const v = (value || '').trim();
  if (!v) return '';
  let host;
  try { host = new URL(/^[a-z]+:\/\//i.test(v) ? v : `http://${v}`).hostname.toLowerCase(); } catch { return ''; }
  if (!host.includes('.') || PLACEHOLDER_HOSTS.includes(host) || /^[\d.]+$/.test(host)) return '';
  return host;
}

function loadEnv() {
  if (!fs.existsSync(ENV_FILE)) die('.env not found. Copy _env.sample to .env and fill in values.');
  const env = {};
  for (const line of fs.readFileSync(ENV_FILE, 'utf8').split('\n')) {
    const t = line.trim();
    const i = t.indexOf('=');
    if (!t || t.startsWith('#') || i === -1) continue;
    env[t.slice(0, i).trim()] = t.slice(i + 1).trim().replace(/^(['"])(.*)\1$/, '$2');
  }
  const port = (k, d) => parseInt(env[k] || d, 10);
  return {
    project: env.PROJECT_NAME || 'tribe',
    email: env.CONTACT_EMAIL || 'your-name@your-collective.org',
    services: [
      { label: 'tribe',     domain: hostFromEnv(env.BARE_URL),           port: port('TRIBE_PORT', '12000'),     www: false },
      { label: 'junction',  domain: hostFromEnv(env.JUNCTION_URL),       port: port('JUNCTION_PORT', '12002'),  www: false },
      { label: 'dist',      domain: hostFromEnv(env.DIST_URL),           port: port('DIST_PORT', '12003'),      www: true  },
      { label: 'dist-php',  domain: hostFromEnv(env.DIST_PHP_URL),       port: port('DIST_PHP_PORT', '12004'),  www: true  },
      { label: 'plausible', domain: hostFromEnv(env.PLAUSIBLE_BASE_URL), port: port('PLAUSIBLE_PORT', '12005'), www: false },
    ],
  };
}

function nginxSiteConfig(label, domain, alias, port) {
  return `# Auto-generated by vhost for service: ${label}
server {
    listen 80;
    listen [::]:80;
    server_name ${alias ? `${domain} ${alias}` : domain};
    client_max_body_size 2048M;
    location / {
        proxy_pass         http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   Referer           $scheme://$host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }
}
`;
}

const availablePath = (d) => path.join(NGINX_AVAILABLE, d);
const enabledPath = (d) => path.join(NGINX_ENABLED, d);
const nginxFileExists = (d) => fs.existsSync(availablePath(d)) || fs.existsSync(enabledPath(d));

function writeNginxSite(label, domain, alias, port) {
  const target = availablePath(domain);
  const link = enabledPath(domain);
  fs.writeFileSync(target, nginxSiteConfig(label, domain, alias, port));
  log(`Wrote ${target}`);
  try { fs.unlinkSync(link); } catch {}
  fs.symlinkSync(target, link);
  log(`Enabled ${link}`);
}

function nginxReload() {
  if (spawnSync('nginx', ['-t'], { stdio: 'inherit' }).status !== 0) {
    warn('nginx -t failed; not reloading. Fix config and retry.');
    return;
  }
  if (spawnSync('systemctl', ['reload', 'nginx'], { stdio: 'inherit' }).status !== 0) {
    spawnSync('nginx', ['-s', 'reload'], { stdio: 'inherit' });
  }
  log('nginx reloaded.');
}

function runCertbot(email, domain, alias) {
  const args = ['--nginx', '--non-interactive', '--agree-tos', '-m', email, '--redirect', '-d', domain];
  if (alias) args.push('-d', alias);
  info(`certbot ${args.join(' ')}`);
  if (spawnSync('certbot', args, { stdio: 'inherit' }).status === 0) log(`Certificate obtained for ${domain}${alias ? ` (+ ${alias})` : ''}`);
  else warn(`certbot failed for ${domain}. nginx is still serving on :80; you can re-run certbot later.`);
}

let rl = null, queue = [], waiters = [], closed = false;
function prompt(question) {
  if (!rl) {
    rl = readline.createInterface({ input: process.stdin });
    rl.on('line', (l) => (waiters.length ? waiters.shift()(l) : queue.push(l)));
    rl.on('close', () => { closed = true; while (waiters.length) waiters.shift()(''); });
  }
  process.stdout.write(question);
  return new Promise((resolve) => {
    if (queue.length) return resolve(queue.shift().trim());
    if (closed) return resolve('');
    waiters.push((l) => resolve(l.trim()));
  });
}

async function promptYesNo(question, def = true) {
  const ans = (await prompt(`${question} ${def ? '[Y/n]' : '[y/N]'} `)).toLowerCase();
  return ans ? ans === 'y' || ans === 'yes' : def;
}

async function cmdInstall() {
  const { project, email, services } = loadEnv();
  const tribe = services[0];
  if (!tribe.domain) die('Tribe domain not found. Set BARE_URL in .env to a public domain.');

  console.log(`\n${BOLD}Install vhost (nginx + certbot)${NC}\nProject: ${CYAN}${project}${NC}\n`);
  console.log(`${BOLD}Step 1${NC}: confirm domains detected from .env.\n`);
  console.log(`  tribe: ${CYAN}${tribe.domain}${NC}`);

  const jobs = [];
  for (const s of services) {
    if (s !== tribe) {
      if (!s.domain) { console.log(`  ${s.label}: ${YELLOW}not set in .env, skipping${NC}`); continue; }
      if (!(await promptYesNo(`  Install ${s.label} (${s.domain})?`))) continue;
    }
    const alias = s.www && !s.domain.startsWith('www.') && (await promptYesNo(`    └ Add www.${s.domain} alias?`, false)) ? `www.${s.domain}` : '';
    const existing = [s.domain, alias].find((d) => d && nginxFileExists(d));
    if (existing) { warn(`Skipping ${s.label}: nginx file already exists for '${existing}'.`); continue; }
    jobs.push({ ...s, alias });
  }

  if (!jobs.length) { warn('Nothing to do.'); return; }

  const cwd = process.cwd();
  console.log(`\n${BOLD}Step 2${NC}: confirm install location.\n  Running from: ${CYAN}${cwd}${NC}  (folder: ${path.basename(cwd)})\n\n  Will configure:`);
  for (const j of jobs) console.log(`    ${j.label.padEnd(10)} ${j.domain}${j.alias ? ` , ${j.alias}` : ''}  →  127.0.0.1:${j.port}`);
  console.log('');
  if (!(await promptYesNo('Proceed?'))) die('Aborted.');

  for (const j of jobs) {
    console.log('');
    info(`Configuring ${j.label}: ${j.domain}${j.alias ? ` (+ ${j.alias})` : ''}`);
    writeNginxSite(j.label, j.domain, j.alias, j.port);
    nginxReload();
    runCertbot(email, j.domain, j.alias);
  }
  console.log('');
  log('vhost install complete.');
}

function cmdStatus() {
  const { services } = loadEnv();
  const files = fs.existsSync(NGINX_ENABLED) ? fs.readdirSync(NGINX_ENABLED) : [];
  console.log(`\n${BOLD}vhost status${NC}`);
  for (const { label, port } of services) {
    const sites = files.filter((f) => {
      try {
        const c = fs.readFileSync(availablePath(f), 'utf8');
        return c.includes(`service: ${label}\n`) && c.includes(`127.0.0.1:${port};`);
      } catch { return false; }
    });
    console.log(sites.length
      ? `  ${GREEN}●${NC} ${label.padEnd(10)} :${port}  →  ${sites.join(', ')}`
      : `  ${YELLOW}○${NC} ${label.padEnd(10)} :${port}  (no nginx site)`);
  }
  console.log('');
}

async function cmdUninstall() {
  console.log('');
  warn('This removes the nginx site file for the domain you name. Certificates stay (use `certbot delete`).');
  const domain = await prompt('Domain to remove (exact server_name, blank to abort): ');
  if (!domain) die('Aborted.');
  if (!fs.existsSync(availablePath(domain))) warn(`No nginx file at ${availablePath(domain)}.`);
  for (const p of [enabledPath(domain), availablePath(domain)]) {
    try { fs.unlinkSync(p); log(`Removed ${p}`); } catch {}
  }
  nginxReload();
  log('Uninstall complete.');
}

(async () => {
  const cmd = process.argv[2];
  if (!cmd || cmd === 'install') await cmdInstall();
  else if (cmd === 'status') cmdStatus();
  else if (cmd === 'uninstall') await cmdUninstall();
  else { console.log('Usage: node vhost [install|status|uninstall]'); process.exitCode = 1; }
  if (rl) rl.close();
})();
