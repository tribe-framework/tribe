# ══════════════════════════════════════════════════════════════════════════════
# Tribe Framework — Environment Configuration (shared-services variant)
# Copy this file to .env and fill in your values before running docker compose.
#
# This stack starts no MySQL, no Tika and no Typesense. MySQL and Tika are
# consumed from an adjacent stack over published host ports, reached inside
# these containers at the hostname `shared-services`.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Project Identity ─────────────────────────────────────────────────────────
PROJECT_NAME=tribe

# ─── Shared Services (adjacent stack) ─────────────────────────────────────────
# SHARED_SERVICES_HOST: leave as host-gateway when the adjacent stack runs on
# this same machine. Set to an IP or hostname when it runs elsewhere.
SHARED_SERVICES_HOST=host-gateway
SHARED_DB_PORT=3306
SHARED_TIKA_PORT=9998

# ─── Application ──────────────────────────────────────────────────────────────
# BARE_URL: set to your server's public IP or domain on remote deployments.
BARE_URL=localhost
ALLOW_ALL_CONNECTIONS_DANGEROUSLY=false
DISPLAY_ERRORS=false
DEFAULT_TIMEZONE=Asia/Kolkata
CONTACT_EMAIL=your-name@your-collective.org
CACHE_WEBAPP_TOTAL_OBJECTS=false

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_ROOT_PASSWORD must match the root password of the adjacent stack's MySQL.
# DB_HOST and DB_PORT are injected by compose and are not set here.
DB_ROOT_PASSWORD=rootpassword
DB_NAME=tribe_db
DB_USER=tribe_user
DB_PASS=userpassword

# ─── Ports ────────────────────────────────────────────────────────────────────
TRIBE_PORT=13000
PHPMYADMIN_PORT=13001
JUNCTION_PORT=13002
DIST_PORT=13003
DIST_PHP_PORT=13004
CRONICLE_PORT=13007
CENTRIFUGO_PORT=13008

# ─── Junction ─────────────────────────────────────────────────────────────────
JUNCTION_SLUG=junction
JUNCTION_PASSWORD=password
TRIBE_API_URL=http://localhost:13000
TRIBE_API_KEY=

# ─── Plausible Analytics (optional) ──────────────────────────────────────────
PLAUSIBLE_AUTH=
PLAUSIBLE_DOMAIN=

# ─── Search and Extraction ────────────────────────────────────────────────────
# Typesense is not part of this variant. Search features that depend on it
# should be left disabled.
TRANSCRIBE_FILE_RECORDS=false

# ─── Hide Postcode Attribution ────────────────────────────────────────────────
HIDE_POSTCODE_ATTRIBUTION=false

# ─── Cronicle ─────────────────────────────────────────────────────────────────
CRONICLE_SECRET_KEY=changeme_cronicle_key
CRONICLE_LOG_KEEP_DAYS=30

# ─── Centrifugo ───────────────────────────────────────────────────────────────
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=changeme_centrifugo_secret
CENTRIFUGO_HTTP_API_KEY=changeme_centrifugo_api_key
CENTRIFUGO_ADMIN_PASSWORD=msgpassword
CENTRIFUGO_ADMIN_SECRET=changeme_admin_secret
